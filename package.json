{
  "name": "easyride-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "EasyRide — Intelligent Urban Mobility & Delivery Dispatch Platform",
  "main": "index.js",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:api": "npm --prefix services/api run dev",
    "dev:web": "npm --prefix apps/web run dev",
    "dev:ml": "cd services/ml-service && python -m uvicorn main:app --reload --port 8001",
    "dev:dispatch": "cd services/dispatch-engine && python -m uvicorn main:app --reload --port 8002",
    "build": "npm --prefix packages/shared-types run build && npm --prefix services/api run build && npm --prefix apps/web run build",
    "seed": "node scripts/seed.js",
    "simulate": "node scripts/simulate.js"
  },
  "keywords": [
    "easyride",
    "dispatch-engine",
    "urban-mobility",
    "logistics",
    "ml",
    "react",
    "nodejs",
    "express",
    "postgis",
    "python"
  ],
  "author": "EasyRide Engineering",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
