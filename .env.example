# EasyRide Configuration Environment Variables

# Node API Server
PORT=5000
NODE_ENV=development
JWT_SECRET=easyride_jwt_secret_key_super_secure_2026
JWT_REFRESH_SECRET=easyride_jwt_refresh_secret_key_2026
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# PostgreSQL & PostGIS
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/easyride_db
USE_POSTGRES_DB=false

# Redis & Caching
REDIS_URL=redis://localhost:6379
USE_REDIS=false

# Python Services
ML_SERVICE_URL=http://localhost:8001
DISPATCH_ENGINE_URL=http://localhost:8002

# Maps API (Google Maps / Mapbox / OpenStreetMap fallback)
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Payment Provider (Razorpay)
RAZORPAY_KEY_ID=rzp_test_easyride_mock_12345
RAZORPAY_KEY_SECRET=rzp_secret_easyride_mock_67890

# Firebase Notifications
FIREBASE_PROJECT_ID=easyride-dev-mock
